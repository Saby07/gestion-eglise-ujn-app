# Application
GIN_MODE=debug
PORT=8080
SERVER=0.0.0.0
RUN_SEED=true
ADMIN_EMAIL=superadmin@eglise-ujn.local
ADMIN_PASSWORD=ChangeMe123!

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_TTL_HOURS=48
COOKIE_NAME=eglise_auth

# Base de données locale (SQLite — par défaut)
DB_DRIVER=sqlite
DB_PATH=./data/eglise_ujn.db

# MySQL (production) — décommenter et définir DB_DRIVER=mysql
# DB_DRIVER=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=eglise_ujn
