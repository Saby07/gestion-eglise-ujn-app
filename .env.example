# Application
GIN_MODE=debug
PORT=8066
SERVER=0.0.0.0
RUN_SEED=true
ADMIN_EMAIL=superadmin@eglise-ujn.local
ADMIN_PASSWORD=ChangeMe123!

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_TTL_HOURS=48
COOKIE_NAME=eglise_auth

# ── Base de données ──────────────────────────────────────────
# Un seul DB_DRIVER actif à la fois.

# Développement local (SQLite)
DB_DRIVER=sqlite
DB_PATH=./data/eglise_ujn.db

# Production (MySQL) — remplacer DB_DRIVER par mysql
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=eglise_ujn
# DB_USER=root
# DB_PASSWORD=root
