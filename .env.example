# Application
GIN_MODE=debug
PORT=8066
SERVER=0.0.0.0
RUN_SEED=false

# Super admin (seul compte créé par le seed)
ADMIN_EMAIL=superadmin@eglise-ujn.local
ADMIN_PASSWORD=ChangeMe123!

# JWT — en production : secret aléatoire d'au moins 32 caractères
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_TTL_HOURS=48
COOKIE_NAME=eglise_auth

# Production HTTPS (derrière nginx/caddy) — cookies Secure + SameSite
# COOKIE_SECURE=true
# TRUSTED_PROXIES=127.0.0.1,::1

# En production (GIN_MODE=release) : ADMIN_PASSWORD fort obligatoire pour le seed

# ── Base de données ──────────────────────────────────────────
# Un seul DB_DRIVER actif à la fois.

# Développement local (SQLite)
DB_DRIVER=sqlite
DB_PATH=./data/eglise_ujn.db

# Production (MySQL) — remplacer DB_DRIVER par mysql
# DB_DRIVER=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=eglise_ujn
# DB_USER=root
# DB_PASSWORD=root

# Rappels & sauvegarde
# REMINDER_ENABLED=true    # relance les validations en attente (toutes les 24h)
# BACKUP_ON_START=true     # sauvegarde DB + uploads au démarrage (dossier backups/)

# Email SMTP — configurable aussi via /settings (Super Admin)
# smtp_host, smtp_port, smtp_user, smtp_password, smtp_from
