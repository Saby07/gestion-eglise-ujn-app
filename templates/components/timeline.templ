package components

import "eglise_ujn/templates/viewmodels"

templ RequisitionTimeline(events []viewmodels.TimelineEventVM) {
	<div class="card border-0 shadow-sm mb-4">
		<div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
			<i class="ri-time-line text-primary fs-18"></i>
			<h5 class="card-title mb-0">Historique</h5>
		</div>
		<div class="card-body">
			if len(events) == 0 {
				<p class="text-muted mb-0">Aucun événement enregistré.</p>
			} else {
				<div class="timeline-vertical">
					for i, ev := range events {
						<div class={ "timeline-item d-flex gap-3", templ.KV("pb-4", i < len(events)-1) }>
							<div class="flex-shrink-0">
								<span class={ "avatar-xs d-inline-flex align-items-center justify-content-center rounded-circle", ev.IconBg }>
									<i class={ ev.Icon }></i>
								</span>
								if i < len(events)-1 {
									<div class="timeline-connector ms-2 mt-1"></div>
								}
							</div>
							<div class="flex-grow-1 pb-1">
								<div class="d-flex flex-wrap justify-content-between gap-2 mb-1">
									<h6 class="mb-0 fs-14">{ ev.Title }</h6>
									if ev.Date != "" {
										<span class="text-muted fs-12">{ ev.Date }</span>
									}
								</div>
								if ev.Actor != "" {
									<p class="text-muted fs-13 mb-1"><i class="ri-user-3-line me-1"></i>{ ev.Actor }</p>
								}
								if ev.Description != "" {
									<p class="text-muted fs-13 mb-0">{ ev.Description }</p>
								}
							</div>
						</div>
					}
				</div>
			}
		</div>
	</div>
}
