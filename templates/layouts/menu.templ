package layouts

import "eglise_ujn/templates/viewmodels"

templ Menu(vm viewmodels.LayoutVM) {
	<div class="navbar-brand-box">
		<a href="/dashboard" class="logo logo-dark">
			<span class="logo-sm">
				<img src="/assets/images/logo-sm.png" alt="" height="22">
			</span>
			<span class="logo-lg">
				<img src="/assets/images/logo-dark.png" alt="" height="37">
			</span>
		</a>
		<a href="/dashboard" class="logo logo-light">
			<span class="logo-sm">
				<img src="/assets/images/logo-sm.png" alt="" height="22">
			</span>
			<span class="logo-lg">
				<img src="/assets/images/logo-light.png" alt="" height="37">
			</span>
		</a>
		<button type="button" class="btn btn-sm p-0 fs-20 header-item float-end btn-vertical-sm-hover" id="vertical-hover">
			<i class="ri-record-circle-line"></i>
		</button>
	</div>
	<div id="scrollbar">
		<div class="container-fluid">
			<ul class="navbar-nav" id="navbar-nav">
				<li class="menu-title"><span>Menu</span></li>
				<li class="nav-item">
					<a class={ "nav-link menu-link", templ.KV("active", vm.ActiveMenu == "dashboard") } href="/dashboard">
						<i class="ri-dashboard-2-line"></i> <span>Tableau de bord</span>
					</a>
				</li>
				if vm.CanManageUsers() {
					<li class="nav-item">
						<a class={ "nav-link menu-link", templ.KV("active", vm.ActiveMenu == "users") } href="/users">
							<i class="ri-team-line"></i> <span>Utilisateurs</span>
						</a>
					</li>
				}
				if vm.CanManageAccounts() {
					<li class="nav-item">
						<a class={ "nav-link menu-link", templ.KV("active", vm.ActiveMenu == "accounts") } href="/accounts">
							<i class="ri-bank-line"></i> <span>Comptes</span>
						</a>
					</li>
				}
				<li class="nav-item">
					<a class={ "nav-link menu-link", templ.KV("active", vm.ActiveMenu == "requisitions") } href="/requisitions">
						<i class="ri-file-list-3-line"></i> <span>Réquisitions</span>
					</a>
				</li>
				if vm.CanCreateRequisition() {
					<li class="nav-item">
						<a class="nav-link menu-link" href="/requisitions/new">
							<i class="ri-add-circle-line"></i> <span>Nouvelle réquisition</span>
						</a>
					</li>
				}
				if vm.CanViewReports() {
					<li class="nav-item">
						<a class={ "nav-link menu-link", templ.KV("active", vm.ActiveMenu == "reports") } href="/reports">
							<i class="ri-bar-chart-line"></i> <span>Rapports</span>
						</a>
					</li>
				}
			</ul>
		</div>
	</div>
	<div class="sidebar-background"></div>
}
