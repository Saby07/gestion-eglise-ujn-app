package pages

import (
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
)

templ AuditLog(vm viewmodels.LayoutVM, rows []viewmodels.AuditLogRow) {
	@AppLayoutDataTables(vm, auditLogBody(vm, rows))
}

templ auditLogBody(vm viewmodels.LayoutVM, rows []viewmodels.AuditLogRow) {
	@components.PageHeader("Journal d'audit", "Audit")
	<div class="card">
		<div class="card-body app-datatable-card">
			<table id="audit-datatable" class="table table-striped table-sm align-middle dt-responsive nowrap w-100">
				<thead class="table-light">
					<tr>
						<th>Date</th>
						<th>Utilisateur</th>
						<th>Action</th>
						<th>Entité</th>
						<th>Détails</th>
						<th>IP</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range rows {
						<tr>
							<td data-order={ r.CreatedAt }>{ r.CreatedAt }</td>
							<td>{ r.UserName }</td>
							<td><span class="badge bg-soft-primary text-primary">{ r.Action }</span></td>
							<td>{ r.Entity }</td>
							<td class="text-muted">{ r.Details }</td>
							<td class="text-muted">{ r.IP }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
