package pages

import (
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
)

templ Categories(vm viewmodels.LayoutVM, list []viewmodels.CategoryVM) {
	@AppLayout(vm, categoriesBody(vm, list))
}

templ categoriesBody(vm viewmodels.LayoutVM, list []viewmodels.CategoryVM) {
	@components.PageHeader("Catégories de dépenses", "Catégories")
	<div class="row g-4">
		<div class="col-lg-4">
			<div class="card">
				<div class="card-header"><h5 class="card-title mb-0">Nouvelle catégorie</h5></div>
				<div class="card-body">
					<form method="post" action="/categories">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<div class="mb-3">
							<label class="form-label">Nom <span class="text-danger">*</span></label>
							<input name="name" class="form-control" required/>
						</div>
						<div class="mb-3">
							<label class="form-label">Description</label>
							<textarea name="description" class="form-control" rows="2"></textarea>
						</div>
						<button class="btn btn-success w-100"><i class="ri-add-line me-1"></i> Ajouter</button>
					</form>
				</div>
			</div>
		</div>
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-striped table-sm align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Nom</th>
									<th>Description</th>
									<th>Statut</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, c := range list {
									<tr>
										<td class="fw-medium">{ c.Name }</td>
										<td class="text-muted">{ c.Description }</td>
										<td>
											if c.Active {
												<span class="badge bg-success">Actif</span>
											} else {
												<span class="badge bg-secondary">Inactif</span>
											}
										</td>
										<td class="text-end">
											<div class="d-flex justify-content-end gap-1">
												<form method="post" action={ fmt.Sprintf("/categories/%d/toggle", c.ID) } class="d-inline">
													<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
													<button type="submit" class="btn btn-sm btn-soft-secondary btn-icon" title="Activer/Désactiver">
														<i class="ri-shut-down-line"></i>
													</button>
												</form>
												<form method="post" action={ fmt.Sprintf("/categories/%d/delete", c.ID) } class="d-inline" onsubmit="return confirm('Supprimer cette catégorie ?')">
													<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
													<button type="submit" class="btn btn-sm btn-soft-danger btn-icon" title="Supprimer">
														<i class="ri-delete-bin-line"></i>
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
}
