package pages

import (
	"eglise_ujn/internal/models"
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
)

templ ProfilePasswordForm(vm viewmodels.LayoutVM, user *models.User) {
	@AppLayout(vm, profilePasswordFormBody(vm, user))
}

templ profilePasswordFormBody(vm viewmodels.LayoutVM, user *models.User) {
	@components.PageHeader("Modifier mon mot de passe", "", vm.Alert)
	<div class="row justify-content-center">
		<div class="col-lg-6">
			<div class="card">
				<div class="card-body">
					<p class="text-muted mb-3">Compte : <strong>{ user.FullName() }</strong> ({ user.Email })</p>
					<form method="post" action="/profile/password">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<div class="mb-3">
							<label class="form-label">Mot de passe actuel</label>
							<input type="password" name="current_password" class="form-control" required autocomplete="current-password"/>
						</div>
						<div class="mb-3">
							<label class="form-label">Nouveau mot de passe</label>
							<input type="password" name="password" class="form-control" minlength="8" required autocomplete="new-password"/>
						</div>
						<div class="mb-3">
							<label class="form-label">Confirmer le nouveau mot de passe</label>
							<input type="password" name="password_confirm" class="form-control" minlength="8" required autocomplete="new-password"/>
						</div>
						<div class="d-flex gap-2">
							<button class="btn btn-success">Mettre à jour</button>
							<a href="/dashboard" class="btn btn-light">Annuler</a>
						</div>
					</form>
				</div>
			</div>
		</div>
	</div>
}
