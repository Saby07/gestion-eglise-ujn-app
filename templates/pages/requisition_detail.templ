package pages

import (
	"eglise_ujn/internal/models"
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
)

templ RequisitionDetail(vm viewmodels.LayoutVM, req *models.Requisition, user *models.User, accounts []models.ChurchAccount, canValidate, canCancel, canDisburse bool) {
	@AppLayout(vm, requisitionDetailBody(vm, req, accounts, canValidate, canCancel, canDisburse))
}

templ reqMetaItem(icon, label, value string) {
	<div class="req-meta-item">
		<div class="req-meta-icon"><i class={ icon }></i></div>
		<div>
			<div class="req-meta-label">{ label }</div>
			<div class="req-meta-value">{ value }</div>
		</div>
	</div>
}

templ reqDocLink(href, icon, label string) {
	<a href={ href } target="_blank" class="req-doc-link">
		<i class={ icon }></i>
		<span>{ label }</span>
		<i class="ri-external-link-line req-doc-external"></i>
	</a>
}

templ requisitionDetailBody(vm viewmodels.LayoutVM, req *models.Requisition, accounts []models.ChurchAccount, canValidate, canCancel, canDisburse bool) {
	@components.PageHeader(req.Title, "Réquisitions")
	@components.WorkflowTracker(viewmodels.BuildWorkflowSteps(req))
	<div class="card card-bordered border mb-4">
		<div class="card-body p-4">
			<div class="row align-items-center g-4">
				<div class="col-lg-5">
					<div class="req-amount-block">
						<span class="text-muted text-uppercase fs-12 fw-medium">Montant total</span>
						<h2 class="req-amount-value mb-2">{ fmt.Sprintf("%.2f", req.TotalAmount) } <small class="fs-16 text-muted">USD</small></h2>
						<span class={ "badge fs-12", viewmodels.StatusClass(req.Status, req.CurrentStep) }>{ viewmodels.StepLabel(req.CurrentStep) }</span>
					</div>
				</div>
				<div class="col-lg-7">
					<div class="row g-3">
						<div class="col-sm-6 col-xl-4">
							@reqMetaItem("ri-user-3-line", "Auteur", req.User.FullName())
						</div>
						<div class="col-sm-6 col-xl-4">
							@reqMetaItem("ri-calendar-line", "Date", req.RequisitionDate.Format("02/01/2006"))
						</div>
						<div class="col-sm-6 col-xl-4">
							@reqMetaItem("ri-file-list-3-line", "Articles", fmt.Sprintf("%d ligne(s)", len(req.Items)))
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<div class="row g-4 mb-5">
		<div class="col-lg-8">
			<div class="card border-0 shadow-sm mb-0">
				<div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
					<i class="ri-list-check-2 text-primary fs-18"></i>
					<h5 class="card-title mb-0">Détail des articles</h5>
				</div>
				<div class="card-body p-0">
					<div class="table-responsive">
						<table class="table table-hover align-middle mb-0 req-items-table">
							<thead>
								<tr>
									<th class="ps-4">Désignation</th>
									<th class="text-end">Qté</th>
									<th class="text-end">P.U.</th>
									<th class="text-end pe-4">Total</th>
								</tr>
							</thead>
							<tbody>
								for _, it := range req.Items {
									<tr>
										<td class="ps-4 fw-medium">{ it.Designation }</td>
										<td class="text-end text-muted">{ fmt.Sprintf("%.2f", it.Quantity) }</td>
										<td class="text-end text-muted">{ fmt.Sprintf("%.2f", it.UnitPrice) }</td>
										<td class="text-end pe-4 fw-semibold">{ fmt.Sprintf("%.2f", it.TotalPrice) }</td>
									</tr>
								}
							</tbody>
							<tfoot>
								<tr>
									<td colspan="3" class="ps-4 text-end fw-semibold text-muted">Total général</td>
									<td class="text-end pe-4 fw-bold text-primary fs-15">{ fmt.Sprintf("%.2f USD", req.TotalAmount) }</td>
								</tr>
							</tfoot>
						</table>
					</div>
				</div>
			</div>
			if req.SupplierName != "" || req.InvoicePath != "" {
				<div class="card border-0 shadow-sm mt-4">
					<div class="card-header bg-transparent border-bottom d-flex align-items-center gap-2 py-3">
						<i class="ri-file-paper-2-line text-primary fs-18"></i>
						<h5 class="card-title mb-0">Justifications & fournisseur</h5>
					</div>
					<div class="card-body">
						if req.SupplierName != "" {
							<div class="req-supplier-block mb-4">
								<div class="d-flex align-items-start gap-3">
									<div class="req-meta-icon"><i class="ri-store-2-line"></i></div>
									<div>
										<div class="fw-semibold mb-1">{ req.SupplierName }</div>
										if req.SupplierPhone != "" {
											<div class="text-muted small mb-1"><i class="ri-phone-line me-1"></i>{ req.SupplierPhone }</div>
										}
										if req.SupplierAddress != "" {
											<div class="text-muted small"><i class="ri-map-pin-line me-1"></i>{ req.SupplierAddress }</div>
										}
									</div>
								</div>
							</div>
						}
						<div class="req-docs-grid">
							if req.InvoicePath != "" {
								@reqDocLink(req.InvoicePath, "ri-file-text-line", "Facture")
							}
							if req.DeliveryNotePath != "" {
								@reqDocLink(req.DeliveryNotePath, "ri-truck-line", "Bon de livraison")
							}
							if req.PurchaseOrderPath != "" {
								@reqDocLink(req.PurchaseOrderPath, "ri-shopping-cart-line", "Bon de commande")
							}
							if req.ReceptionNotePath != "" {
								@reqDocLink(req.ReceptionNotePath, "ri-inbox-archive-line", "Bon de réception")
							}
						</div>
					</div>
				</div>
			}
		</div>
		<div class="col-lg-4">
			<div class="req-actions-sidebar">
				if canValidate {
					<div class="card border-0 shadow-sm mb-4 req-action-card req-action-card--validate">
						<div class="card-header bg-transparent border-bottom py-3">
							<div class="d-flex align-items-center gap-2">
								<span class="req-action-icon req-action-icon--success"><i class="ri-checkbox-circle-line"></i></span>
								<h5 class="card-title mb-0">Validation</h5>
							</div>
						</div>
						<div class="card-body">
							if vm.IsAccountant && req.CurrentStep == models.StepPendingAccountant {
								<form method="post" action={ fmt.Sprintf("/requisitions/%d/validate", req.ID) } enctype="multipart/form-data">
									<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
									<p class="text-muted small mb-3">Les pièces jointes et infos fournisseur sont optionnelles.</p>
									<div class="mb-2"><label class="form-label">Facture</label><input type="file" name="invoice" class="form-control form-control-sm"/></div>
									<div class="mb-2"><label class="form-label">Bon de livraison</label><input type="file" name="delivery_note" class="form-control form-control-sm"/></div>
									<div class="mb-2"><label class="form-label">Bon de commande</label><input type="file" name="purchase_order" class="form-control form-control-sm"/></div>
									<div class="mb-2"><label class="form-label">Bon de réception</label><input type="file" name="reception_note" class="form-control form-control-sm"/></div>
									<div class="mb-2"><input name="supplier_name" class="form-control form-control-sm" placeholder="Nom fournisseur"/></div>
									<div class="mb-2"><input name="supplier_phone" class="form-control form-control-sm" placeholder="Téléphone fournisseur"/></div>
									<div class="mb-2"><input name="supplier_address" class="form-control form-control-sm" placeholder="Adresse fournisseur"/></div>
									<div class="mb-3"><textarea name="comment" class="form-control form-control-sm" rows="2" placeholder="Commentaire"></textarea></div>
									<button class="btn btn-success w-100"><i class="ri-check-line me-1"></i> Valider cette étape</button>
								</form>
							} else {
								<form method="post" action={ fmt.Sprintf("/requisitions/%d/validate", req.ID) }>
									<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
									<div class="mb-3"><textarea name="comment" class="form-control form-control-sm" rows="2" placeholder="Commentaire"></textarea></div>
									<button class="btn btn-success w-100"><i class="ri-check-line me-1"></i> Valider cette étape</button>
								</form>
							}
						</div>
					</div>
				}
				if canDisburse {
					<div class="card border-0 shadow-sm mb-4 req-action-card req-action-card--disburse">
						<div class="card-header bg-transparent border-bottom py-3">
							<div class="d-flex align-items-center gap-2">
								<span class="req-action-icon req-action-icon--info"><i class="ri-wallet-3-line"></i></span>
								<h5 class="card-title mb-0">Décaissement</h5>
							</div>
						</div>
						<div class="card-body">
							<form method="post" action={ fmt.Sprintf("/requisitions/%d/disburse", req.ID) } enctype="multipart/form-data">
								<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
								<div class="mb-2">
									<label class="form-label">Compte *</label>
									<select name="account_id" class="form-select form-select-sm" required>
										for _, a := range accounts {
											<option value={ fmt.Sprintf("%d", a.ID) }>{ a.Name } ({ fmt.Sprintf("%.2f", a.Balance) })</option>
										}
									</select>
								</div>
								<div class="mb-2">
									<label class="form-label">Mode de paiement *</label>
									<select name="payment_mode" class="form-select form-select-sm" required>
										for _, m := range models.AllPaymentModes() {
											<option value={ string(m) }>{ m.Label() }</option>
										}
									</select>
								</div>
								<div class="mb-2"><label class="form-label">Reçu (optionnel)</label><input type="file" name="receipt" class="form-control form-control-sm"/></div>
								<div class="mb-3"><textarea name="note" class="form-control form-control-sm" rows="2" placeholder="Note"></textarea></div>
								<button class="btn btn-primary w-100"><i class="ri-money-dollar-circle-line me-1"></i> Décaisser { fmt.Sprintf("%.2f USD", req.TotalAmount) }</button>
							</form>
						</div>
					</div>
				}
				if req.Disbursement != nil {
					<div class="card border-0 shadow-sm mb-4 req-action-card req-action-card--done">
						<div class="card-header bg-transparent border-bottom py-3">
							<div class="d-flex align-items-center gap-2">
								<span class="req-action-icon req-action-icon--primary"><i class="ri-check-double-line"></i></span>
								<h5 class="card-title mb-0">Décaissement effectué</h5>
							</div>
						</div>
						<div class="card-body">
							<div class="req-disburse-info">
								<div class="req-disburse-row">
									<span class="text-muted">Mode</span>
									<span class="fw-medium">{ req.Disbursement.PaymentMode.Label() }</span>
								</div>
								<div class="req-disburse-row">
									<span class="text-muted">Par</span>
									<span class="fw-medium">{ req.Disbursement.DisbursedBy.FullName() }</span>
								</div>
								<div class="req-disburse-row">
									<span class="text-muted">Le</span>
									<span class="fw-medium">{ req.Disbursement.DisbursedAt.Format("02/01/2006 15:04") }</span>
								</div>
							</div>
							if req.Disbursement.ReceiptPath != "" {
								<a href={ req.Disbursement.ReceiptPath } target="_blank" class="btn btn-sm btn-soft-primary w-100 mt-3"><i class="ri-file-download-line me-1"></i> Voir le reçu</a>
							}
						</div>
					</div>
				}
				if canCancel {
					<div class="card border-0 shadow-sm mb-4 req-action-card req-action-card--cancel">
						<div class="card-header bg-transparent border-bottom py-3">
							<div class="d-flex align-items-center gap-2">
								<span class="req-action-icon req-action-icon--danger"><i class="ri-close-circle-line"></i></span>
								<h5 class="card-title mb-0 text-danger">Annuler</h5>
							</div>
						</div>
						<div class="card-body">
							<form method="post" action={ fmt.Sprintf("/requisitions/%d/cancel", req.ID) }>
								<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
								<textarea name="reason" class="form-control form-control-sm mb-3" rows="2" placeholder="Motif d'annulation" required></textarea>
								<button class="btn btn-danger w-100"><i class="ri-forbid-line me-1"></i> Annuler la réquisition</button>
							</form>
						</div>
					</div>
				}
				if vm.IsAdmin || vm.IsSuperAdmin {
					<form method="post" action={ fmt.Sprintf("/requisitions/%d/delete", req.ID) } onsubmit="return confirm('Supprimer définitivement ?')">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<button class="btn btn-outline-danger btn-sm w-100"><i class="ri-delete-bin-line me-1"></i> Supprimer définitivement</button>
					</form>
				}
			</div>
		</div>
	</div>
}
