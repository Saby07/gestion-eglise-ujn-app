package pages

import (
	"eglise_ujn/internal/models"
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
)

templ RequisitionsList(vm viewmodels.LayoutVM, list []models.Requisition, filter string, search viewmodels.RequisitionSearchVM, categories []viewmodels.CategoryVM) {
	@AppLayoutDataTables(vm, requisitionsListBody(vm, list, filter, search, categories))
}

templ requisitionsListBody(vm viewmodels.LayoutVM, list []models.Requisition, filter string, search viewmodels.RequisitionSearchVM, categories []viewmodels.CategoryVM) {
	@components.PageHeader("Réquisitions", "Réquisitions", vm.Alert)
	<div class="card mb-3">
		<div class="card-body">
			<form method="get" action="/requisitions" class="row g-2 align-items-end">
				<input type="hidden" name="filter" value={ filter }/>
				<div class="col-md-3">
					<label class="form-label">Recherche</label>
					<input name="q" class="form-control form-control-sm" placeholder="Titre, auteur…" value={ search.Q }/>
				</div>
				<div class="col-md-2">
					<label class="form-label">Du</label>
					<input type="date" name="from" class="form-control form-control-sm" value={ search.From }/>
				</div>
				<div class="col-md-2">
					<label class="form-label">Au</label>
					<input type="date" name="to" class="form-control form-control-sm" value={ search.To }/>
				</div>
				if len(categories) > 0 {
					<div class="col-md-3">
						<label class="form-label">Catégorie</label>
						<select name="category_id" class="form-select form-select-sm">
							<option value="">Toutes</option>
							for _, c := range categories {
								<option value={ fmt.Sprintf("%d", c.ID) } selected?={ search.CategoryID == fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
							}
						</select>
					</div>
				}
				<div class="col-md-2">
					<button class="btn btn-sm btn-primary w-100"><i class="ri-search-line me-1"></i> Filtrer</button>
				</div>
			</form>
		</div>
	</div>
	<div class="mb-3 d-flex flex-wrap gap-2">
		if vm.IsStaffOnly() {
			<a href="/requisitions" class={ "btn", btnClass(filter == "all") }>Toutes</a>
			<a href="/requisitions?filter=completed" class={ "btn", btnClass(filter == "completed") }>Terminées</a>
			<a href="/requisitions?filter=cancelled" class={ "btn", btnClass(filter == "cancelled") }>Annulées</a>
		} else {
			<a href="/requisitions" class={ "btn", btnClass(filter == "all") }>Toutes</a>
			<a href="/requisitions?filter=mine" class={ "btn", btnClass(filter == "mine") }>Mes réquisitions</a>
			<a href="/requisitions?filter=pending_validation" class={ "btn", btnClass(filter == "pending_validation") }>À valider</a>
			<a href="/requisitions?filter=pending_disbursement" class={ "btn", btnClass(filter == "pending_disbursement") }>À décaisser</a>
			<a href="/requisitions?filter=completed" class={ "btn", btnClass(filter == "completed") }>Terminées</a>
			<a href="/requisitions?filter=cancelled" class={ "btn", btnClass(filter == "cancelled") }>Annulées</a>
		}
		if vm.CanCreateRequisition() {
			<a href="/requisitions/new" class="btn btn-label btn-success waves-effect waves-light ms-auto">
				<i class="ri-add-line label-icon"></i>
				Nouvelle réquisition
			</a>
		}
	</div>
	<div class="card">
		<div class="card-body app-datatable-card">
			<table id="requisitions-datatable" class="table table-hover table-sm table-striped align-middle dt-responsive nowrap w-100">
				<thead class="table-light">
					<tr>
						<th>#</th>
						<th>Titre</th>
						<th>Auteur</th>
						if showCategoryColumn(list) {
							<th>Catégorie</th>
						}
						<th class="text-end">Date</th>
						<th class="text-end">Montant</th>
						<th class="text-end">Étape</th>
						<th class="text-end">Action</th>
					</tr>
				</thead>
				<tbody>
					for _, r := range list {
						<tr>
							<td>{ fmt.Sprintf("%d", r.ID) }</td>
							<td>{ r.Title }</td>
							<td class="text-start">{ r.User.FullName() }</td>
							if showCategoryColumn(list) {
								<td class="text-muted">{ requisitionListCategory(r) }</td>
							}
							<td class="text-end" data-order={ r.RequisitionDate.Format("2006-01-02") }>{ r.RequisitionDate.Format("02/01/2006") }</td>
							<td class="text-end" data-order={ fmt.Sprintf("%.2f", r.TotalAmount) }>{ fmt.Sprintf("%.2f", r.TotalAmount) } $</td>
							<td class="text-end"><span class={ "badge", viewmodels.StatusClass(r.Status, r.CurrentStep) }>{ viewmodels.StepLabel(r.CurrentStep) }</span></td>
							<td class="text-end"><a href={ fmt.Sprintf("/requisitions/%d", r.ID) } class="btn btn-sm btn-soft-primary">Voir</a></td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}

func btnClass(active bool) string {
	if active {
		return "btn-primary"
	}
	return "btn-soft-secondary"
}

func showCategoryColumn(list []models.Requisition) bool {
	for _, r := range list {
		if requisitionListCategory(r) != "—" {
			return true
		}
	}
	return false
}

func requisitionListCategory(r models.Requisition) string {
	name := viewmodels.MapRequisitions([]models.Requisition{r})[0].CategoryName
	if name == "" {
		return "—"
	}
	return name
}

templ RequisitionForm(vm viewmodels.LayoutVM, accounts []models.ChurchAccount, categories []viewmodels.CategoryVM, suppliers []viewmodels.SupplierVM, canAttachDocs bool) {
	@AppLayout(vm, requisitionFormBody(vm, accounts, categories, suppliers, canAttachDocs))
}

templ requisitionFormBody(vm viewmodels.LayoutVM, accounts []models.ChurchAccount, categories []viewmodels.CategoryVM, suppliers []viewmodels.SupplierVM, canAttachDocs bool) {
	@components.PageHeader("Nouvelle réquisition", "Réquisitions", vm.Alert)
	<div class="card">
		<div class="card-body">
			<form method="post" action="/requisitions" id="req-form" enctype="multipart/form-data">
				<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
				<div class="row g-3 mb-3">
					<div class="col-md-6">
						<label class="form-label">Titre <span class="text-danger">*</span></label>
						<input name="title" class="form-control" required/>
					</div>
					<div class="col-md-4">
						<label class="form-label">Date <span class="text-danger">*</span></label>
						<input type="date" name="date" class="form-control" required/>
					</div>
				</div>
				if len(accounts) > 0 || len(categories) > 0 || len(suppliers) > 0 {
					<div class="row g-3 mb-3">
						if len(accounts) > 0 {
							<div class="col-md-4">
								<label class="form-label">Compte (optionnel)</label>
								<select name="account_id" class="form-select">
									<option value="">— Aucun —</option>
									for _, a := range accounts {
										<option value={ fmt.Sprintf("%d", a.ID) }>{ a.Name }</option>
									}
								</select>
							</div>
						}
						if len(categories) > 0 {
							<div class="col-md-4">
								<label class="form-label">Catégorie (optionnel)</label>
								<select name="category_id" class="form-select">
									<option value="">— Aucune —</option>
									for _, c := range categories {
										<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Name }</option>
									}
								</select>
							</div>
						}
						if len(suppliers) > 0 {
							<div class="col-md-4">
								<label class="form-label">Fournisseur (optionnel)</label>
								<select name="supplier_id" class="form-select">
									<option value="">— Aucun —</option>
									for _, s := range suppliers {
										<option value={ fmt.Sprintf("%d", s.ID) }>{ s.Name }</option>
									}
								</select>
							</div>
						}
					</div>
				}
				if canAttachDocs {
					<h5 class="mb-3">Pièces jointes fournisseur</h5>
					<p class="text-muted small mb-3">Optionnel — facture, bons et infos fournisseur.</p>
					<div class="row g-3 mb-3">
						<div class="col-md-6"><label class="form-label">Facture</label><input type="file" name="invoice" class="form-control"/></div>
						<div class="col-md-6"><label class="form-label">Bon de livraison</label><input type="file" name="delivery_note" class="form-control"/></div>
						<div class="col-md-6"><label class="form-label">Bon de commande</label><input type="file" name="purchase_order" class="form-control"/></div>
						<div class="col-md-6"><label class="form-label">Bon de réception</label><input type="file" name="reception_note" class="form-control"/></div>
						<div class="col-md-4"><input name="supplier_name" class="form-control" placeholder="Nom fournisseur"/></div>
						<div class="col-md-4"><input name="supplier_phone" class="form-control" placeholder="Téléphone"/></div>
						<div class="col-md-4"><input name="supplier_address" class="form-control" placeholder="Adresse"/></div>
					</div>
				}
				<h5 class="mb-3">Articles <span class="text-danger">*</span></h5>
				<div id="items-container">
					<div class="row g-2 mb-2 item-row">
						<div class="col-md-5"><input name="designation" class="form-control" placeholder="Désignation" required/></div>
						<div class="col-md-2"><input type="number" step="0.01" name="quantity" class="form-control" placeholder="Qté" required/></div>
						<div class="col-md-3"><input type="number" step="0.01" name="unit_price" class="form-control" placeholder="Prix unitaire" required/></div>
					</div>
				</div>
				<button type="button" class="btn btn-sm btn-soft-secondary mb-3" onclick="addItemRow()">+ Ajouter une ligne</button>
				<div>
					<button class="btn btn-success">Soumettre la réquisition</button>
				</div>
			</form>
		</div>
	</div>
	<script>
		function addItemRow() {
			var c = document.getElementById('items-container');
			var row = document.createElement('div');
			row.className = 'row g-2 mb-2 item-row';
			row.innerHTML = '<div class="col-md-5"><input name="designation" class="form-control" placeholder="Désignation" required></div>' +
				'<div class="col-md-2"><input type="number" step="0.01" name="quantity" class="form-control" placeholder="Qté" required></div>' +
				'<div class="col-md-3"><input type="number" step="0.01" name="unit_price" class="form-control" placeholder="Prix unitaire" required></div>';
			c.appendChild(row);
		}
	</script>
}
