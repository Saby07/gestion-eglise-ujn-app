package pages

import (
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
	"strings"
)

templ Settings(vm viewmodels.LayoutVM, s viewmodels.SettingsVM) {
	@AppLayout(vm, settingsBody(vm, s))
}

templ settingsBody(vm viewmodels.LayoutVM, s viewmodels.SettingsVM) {
	@components.PageHeader("Paramètres", "Paramètres", vm.Alert)
	<div class="row g-4">
		<div class="col-lg-8">
			<div class="card">
				<div class="card-header"><h5 class="card-title mb-0">Configuration générale</h5></div>
				<div class="card-body">
					<form method="post" action="/settings">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<div class="mb-3">
							<label class="form-label">Nom de l'église</label>
							<input name="church_name" class="form-control" value={ s.ChurchName } required/>
						</div>
						<div class="mb-3">
							<label class="form-label">Thème par défaut</label>
							<select name="dark_mode" class="form-select">
								<option value="0" selected?={ !s.DarkMode }>Clair</option>
								<option value="1" selected?={ s.DarkMode }>Sombre</option>
							</select>
						</div>
						<div class="mb-3">
							<label class="form-label">Jours avant rappel de validation</label>
							<input type="number" name="reminder_days" class="form-control" min="1" max="30" value={ fmt.Sprintf("%d", s.ReminderDays) }/>
						</div>
						<hr/>
						<h6 class="mb-3">Configuration SMTP</h6>
						<div class="row g-3">
							<div class="col-md-8">
								<label class="form-label">Hôte SMTP</label>
								<input name="smtp_host" class="form-control" value={ s.SMTPHost }/>
							</div>
							<div class="col-md-4">
								<label class="form-label">Port</label>
								<input name="smtp_port" class="form-control" value={ s.SMTPPort }/>
							</div>
							<div class="col-md-6">
								<label class="form-label">Utilisateur SMTP</label>
								<input name="smtp_user" class="form-control" value={ s.SMTPUser } autocomplete="off"/>
							</div>
							<div class="col-md-6">
								<label class="form-label">Expéditeur (From)</label>
								<input type="email" name="smtp_from" class="form-control" value={ s.SMTPFrom }/>
							</div>
						</div>
						<div class="mt-4">
							<button class="btn btn-success"><i class="ri-save-line me-1"></i> Enregistrer</button>
						</div>
					</form>
				</div>
			</div>

			<div class="card mt-4">
				<div class="card-header"><h5 class="card-title mb-0">Schéma de validation</h5></div>
				<div class="card-body">
					<p class="text-muted fs-13 mb-3">
						Configurez les capacités par rôle et la chaîne de validation. Le Super Admin reste toujours le dernier validateur.
						Les réquisitions en cours suivent la nouvelle chaîne pour les étapes restantes.
					</p>
					<form method="post" action="/settings/workflow" id="workflow-form">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<h6 class="mb-2">Capacités par rôle</h6>
						<div class="table-responsive mb-4">
							<table class="table table-sm align-middle">
								<thead class="table-light">
									<tr>
										<th>Rôle</th>
										<th class="text-center">Créer</th>
										<th class="text-center">PJ fournisseur</th>
										<th class="text-center">Décaisser</th>
										<th class="text-center">Approvisionner</th>
									</tr>
								</thead>
								<tbody>
									for _, r := range s.WorkflowRoles {
										<tr>
											<td>{ r.Label }</td>
											<td class="text-center">
												<input type="checkbox" class="form-check-input" name={ "cap_create_" + r.Key } value="1" checked?={ r.Create }/>
											</td>
											<td class="text-center">
												<input type="checkbox" class="form-check-input" name={ "cap_attach_" + r.Key } value="1" checked?={ r.AttachDocs }/>
											</td>
											<td class="text-center">
												<input type="checkbox" class="form-check-input" name={ "cap_disburse_" + r.Key } value="1" checked?={ r.Disburse }/>
											</td>
											<td class="text-center">
												<input type="checkbox" class="form-check-input" name={ "cap_fund_" + r.Key } value="1" checked?={ r.Fund }/>
											</td>
										</tr>
									}
								</tbody>
							</table>
						</div>

						<h6 class="mb-2">Chaîne de validation (ordre)</h6>
						<p class="text-muted fs-13">Cochez et ordonnez les validateurs intermédiaires. Le Super Admin est ajouté automatiquement à la fin.</p>
						<div class="list-group mb-3" id="workflow-chain-list">
							for _, item := range s.WorkflowChain {
								<label class="list-group-item d-flex align-items-center gap-3">
									<input type="checkbox" class="form-check-input workflow-chain-cb" name="validation_chain" value={ item.Key } checked?={ item.Selected } data-order={ fmt.Sprintf("%d", item.Order) }/>
									<span class="flex-grow-1">{ item.Label }</span>
									<span class="btn-group btn-group-sm">
										<button type="button" class="btn btn-soft-secondary workflow-up" title="Monter">↑</button>
										<button type="button" class="btn btn-soft-secondary workflow-down" title="Descendre">↓</button>
									</span>
								</label>
							}
							<div class="list-group-item bg-light text-muted">
								<i class="ri-lock-line me-1"></i> Super Admin (obligatoire — dernier validateur)
							</div>
						</div>
						if len(s.WorkflowPreview) > 0 {
							<div class="alert alert-info fs-13 mb-3">
								<strong>Aperçu du flux :</strong> { strings.Join(s.WorkflowPreview, " → ") }
							</div>
						}
						<button class="btn btn-primary"><i class="ri-save-line me-1"></i> Enregistrer le schéma</button>
					</form>
				</div>
			</div>
		</div>
		<div class="col-lg-4">
			<div class="card">
				<div class="card-header"><h5 class="card-title mb-0">Sauvegarde</h5></div>
				<div class="card-body">
					<p class="text-muted fs-13">Générez une sauvegarde complète de la base de données et des fichiers uploadés.</p>
					<form method="post" action="/settings/backup">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<button class="btn btn-primary w-100"><i class="ri-download-cloud-line me-1"></i> Lancer la sauvegarde</button>
					</form>
				</div>
			</div>
			<div class="card mt-3">
				<div class="card-body">
					<h6 class="mb-2">Thème rapide</h6>
					<button type="button" class="btn btn-soft-secondary w-100" data-theme-toggle>
						<i class="ri-contrast-2-line me-1"></i> Basculer clair / sombre
					</button>
				</div>
			</div>
		</div>
	</div>
	<script>
		(function () {
			var list = document.getElementById('workflow-chain-list');
			if (!list) return;
			function reorderHidden() {
				var items = Array.prototype.slice.call(list.querySelectorAll('label.list-group-item'));
				items.forEach(function (el, idx) {
					var cb = el.querySelector('.workflow-chain-cb');
					if (cb) cb.setAttribute('data-order', String(idx));
				});
			}
			list.addEventListener('click', function (e) {
				var btn = e.target.closest('.workflow-up, .workflow-down');
				if (!btn) return;
				e.preventDefault();
				var row = btn.closest('label.list-group-item');
				if (!row) return;
				if (btn.classList.contains('workflow-up') && row.previousElementSibling && row.previousElementSibling.tagName === 'LABEL') {
					list.insertBefore(row, row.previousElementSibling);
				}
				if (btn.classList.contains('workflow-down') && row.nextElementSibling && row.nextElementSibling.tagName === 'LABEL') {
					list.insertBefore(row.nextElementSibling, row);
				}
				reorderHidden();
			});
			document.getElementById('workflow-form').addEventListener('submit', function () {
				var form = this;
				var checked = [];
				list.querySelectorAll('label.list-group-item').forEach(function (el) {
					var cb = el.querySelector('.workflow-chain-cb');
					if (cb && cb.checked) checked.push(cb.value);
				});
				form.querySelectorAll('input[name="validation_chain"]').forEach(function (el) {
					if (el.type === 'hidden') el.remove();
				});
				list.querySelectorAll('.workflow-chain-cb').forEach(function (cb) { cb.disabled = true; });
				checked.forEach(function (v) {
					var input = document.createElement('input');
					input.type = 'hidden';
					input.name = 'validation_chain';
					input.value = v;
					form.appendChild(input);
				});
			});
		})();
	</script>
}
