package pages

import (
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
)

templ Suppliers(vm viewmodels.LayoutVM, list []viewmodels.SupplierVM) {
	@AppLayout(vm, suppliersBody(vm, list))
}

templ suppliersBody(vm viewmodels.LayoutVM, list []viewmodels.SupplierVM) {
	@components.PageHeader("Fournisseurs", "Fournisseurs")
	<div class="row g-4">
		<div class="col-lg-4">
			<div class="card">
				<div class="card-header"><h5 class="card-title mb-0">Nouveau fournisseur</h5></div>
				<div class="card-body">
					<form method="post" action="/suppliers">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<div class="mb-3">
							<label class="form-label">Nom <span class="text-danger">*</span></label>
							<input name="name" class="form-control" required/>
						</div>
						<div class="mb-3">
							<label class="form-label">Téléphone</label>
							<input name="phone" class="form-control"/>
						</div>
						<div class="mb-3">
							<label class="form-label">Email</label>
							<input type="email" name="email" class="form-control"/>
						</div>
						<div class="mb-3">
							<label class="form-label">Adresse</label>
							<textarea name="address" class="form-control" rows="2"></textarea>
						</div>
						<button class="btn btn-success w-100"><i class="ri-add-line me-1"></i> Ajouter</button>
					</form>
				</div>
			</div>
		</div>
		<div class="col-lg-8">
			<div class="card">
				<div class="card-body">
					<div class="table-responsive">
						<table class="table table-striped table-sm align-middle mb-0">
							<thead class="table-light">
								<tr>
									<th>Nom</th>
									<th>Téléphone</th>
									<th>Email</th>
									<th>Adresse</th>
									<th>Statut</th>
									<th class="text-end">Actions</th>
								</tr>
							</thead>
							<tbody>
								for _, s := range list {
									<tr>
										<td class="fw-medium">{ s.Name }</td>
										<td>{ s.Phone }</td>
										<td>{ s.Email }</td>
										<td class="text-muted">{ s.Address }</td>
										<td>
											if s.Active {
												<span class="badge bg-success">Actif</span>
											} else {
												<span class="badge bg-secondary">Inactif</span>
											}
										</td>
										<td class="text-end">
											<div class="d-flex justify-content-end gap-1">
												<a href={ fmt.Sprintf("/suppliers/%d/edit", s.ID) } class="btn btn-sm btn-soft-primary btn-icon" title="Modifier">
													<i class="ri-pencil-line"></i>
												</a>
												<form method="post" action={ fmt.Sprintf("/suppliers/%d/toggle", s.ID) } class="d-inline">
													<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
													<button type="submit" class="btn btn-sm btn-soft-secondary btn-icon" title="Activer/Désactiver">
														<i class="ri-shut-down-line"></i>
													</button>
												</form>
												<form method="post" action={ fmt.Sprintf("/suppliers/%d/delete", s.ID) } class="d-inline" onsubmit="return confirm('Supprimer ce fournisseur ?')">
													<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
													<button type="submit" class="btn btn-sm btn-soft-danger btn-icon" title="Supprimer">
														<i class="ri-delete-bin-line"></i>
													</button>
												</form>
											</div>
										</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
}

templ SupplierEdit(vm viewmodels.LayoutVM, s viewmodels.SupplierVM) {
	@AppLayout(vm, supplierEditBody(vm, s))
}

templ supplierEditBody(vm viewmodels.LayoutVM, s viewmodels.SupplierVM) {
	@components.PageHeader("Modifier fournisseur", "Fournisseurs")
	<div class="card">
		<div class="card-body">
			<form method="post" action={ fmt.Sprintf("/suppliers/%d/edit", s.ID) }>
				<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
				<div class="mb-3">
					<label class="form-label">Nom *</label>
					<input name="name" class="form-control" value={ s.Name } required/>
				</div>
				<div class="mb-3">
					<label class="form-label">Téléphone</label>
					<input name="phone" class="form-control" value={ s.Phone }/>
				</div>
				<div class="mb-3">
					<label class="form-label">Email</label>
					<input type="email" name="email" class="form-control" value={ s.Email }/>
				</div>
				<div class="mb-3">
					<label class="form-label">Adresse</label>
					<textarea name="address" class="form-control" rows="2">{ s.Address }</textarea>
				</div>
				<button class="btn btn-success">Enregistrer</button>
				<a href="/suppliers" class="btn btn-link">Annuler</a>
			</form>
		</div>
	</div>
}
