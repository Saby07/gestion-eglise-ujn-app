package pages

import (
	"eglise_ujn/internal/models"
	"eglise_ujn/templates/components"
	"eglise_ujn/templates/viewmodels"
	"fmt"
)

templ UsersList(vm viewmodels.LayoutVM, users []models.User) {
	@AppLayout(vm, usersListBody(vm, users))
}

templ usersListBody(vm viewmodels.LayoutVM, users []models.User) {
	@components.PageHeader("Utilisateurs", "Utilisateurs", vm.Alert)
	<div class="mb-3">
		<a href="/users/new" class="btn btn-primary"><i class="ri-add-line"></i> Nouvel utilisateur</a>
	</div>
	<div class="card">
		<div class="card-body">
			<div class="table-responsive">
				<table class="table table-striped table-sm align-middle">
					<thead class="table-light">
						<tr>
							<th>Nom</th>
							<th>Email</th>
							<th>Rôles</th>
							<th>Statut</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, u := range users {
							<tr>
								<td>{ u.FullName() }</td>
								<td>{ u.Email }</td>
								<td>{ roleNames(u) }</td>
								<td>
									if u.IsActive {
										<span class="badge bg-success">Actif</span>
									} else {
										<span class="badge bg-secondary">Inactif</span>
									}
								</td>
								<td>
									<div class="d-flex flex-wrap gap-1">
										<a
											href={ fmt.Sprintf("/users/%d/edit", u.ID) }
											class="btn btn-sm btn-soft-primary btn-icon"
											title="Modifier nom, email et rôles"
										>
											<i class="ri-pencil-line"></i>
										</a>
										<a
											href={ fmt.Sprintf("/users/%d/password", u.ID) }
											class="btn btn-sm btn-soft-warning btn-icon"
											title="Modifier le mot de passe"
										>
											<i class="ri-lock-password-line"></i>
										</a>
										<form method="post" action={ fmt.Sprintf("/users/%d/toggle", u.ID) } class="d-inline">
											<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
											<button
												type="submit"
												class="btn btn-sm btn-soft-secondary btn-icon"
												title="Activer/Désactiver"
											>
												<i class="ri-shut-down-line"></i>
											</button>
										</form>
										if u.ID != vm.CurrentUserID {
											<button
												type="button"
												class="btn btn-sm btn-soft-danger btn-icon"
												title="Supprimer"
												data-bs-toggle="modal"
												data-bs-target="#deleteUserModal"
												data-user-id={ fmt.Sprintf("%d", u.ID) }
												data-user-name={ u.FullName() }
											>
												<i class="ri-delete-bin-line"></i>
											</button>
										}
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>
	<div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<div class="modal-header">
					<h5 class="modal-title" id="deleteUserModalLabel">Confirmer la suppression</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
				</div>
				<div class="modal-body">
					<p class="mb-2">
						Êtes-vous sûr de vouloir supprimer l'utilisateur <strong id="deleteUserName"></strong> ?
					</p>
					<p class="text-muted mb-0">Cette action est irréversible.</p>
				</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
					<form id="deleteUserForm" method="post" action="" class="d-inline">
						<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
						<button type="submit" class="btn btn-danger">Supprimer</button>
					</form>
				</div>
			</div>
		</div>
	</div>
	<script>
		document.getElementById('deleteUserModal').addEventListener('show.bs.modal', function (event) {
			var button = event.relatedTarget;
			if (!button) return;
			var userId = button.getAttribute('data-user-id');
			var userName = button.getAttribute('data-user-name');
			document.getElementById('deleteUserName').textContent = userName || '';
			document.getElementById('deleteUserForm').action = '/users/' + userId + '/delete';
		});
	</script>
}

func roleNames(u models.User) string {
	if len(u.Roles) == 0 {
		return "—"
	}
	s := u.Roles[0].Role.Name
	for i := 1; i < len(u.Roles); i++ {
		s += ", " + u.Roles[i].Role.Name
	}
	return s
}

templ UserForm(vm viewmodels.LayoutVM, user *models.User) {
	@AppLayout(vm, userFormBody(vm))
}

templ userFormBody(vm viewmodels.LayoutVM) {
	@components.PageHeader("Nouvel utilisateur", "Utilisateurs", vm.Alert)
	<div class="card">
		<div class="card-body">
			<form method="post" action="/users">
				<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Prénom</label>
						<input name="first_name" class="form-control" required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Nom</label>
						<input name="last_name" class="form-control" required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Email</label>
						<input type="email" name="email" class="form-control" required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Téléphone</label>
						<input name="phone" class="form-control"/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Mot de passe</label>
						<input type="password" name="password" class="form-control" required/>
					</div>
					<div class="col-12">
						<label class="form-label">Rôles</label>
						<div class="d-flex flex-wrap gap-3">
							for _, r := range models.AllRoles {
								<div class="form-check">
									<input class="form-check-input" type="checkbox" name="roles" value={ string(r) } id={ "role-" + string(r) }/>
									<label class="form-check-label" for={ "role-" + string(r) }>{ r.Label() }</label>
								</div>
							}
						</div>
					</div>
				</div>
				<div class="mt-3">
					<button class="btn btn-success">Enregistrer</button>
					<a href="/users" class="btn btn-light">Annuler</a>
				</div>
			</form>
		</div>
	</div>
}

templ UserEditForm(vm viewmodels.LayoutVM, user *models.User) {
	@AppLayout(vm, userEditFormBody(vm, user))
}

templ userEditFormBody(vm viewmodels.LayoutVM, user *models.User) {
	@components.PageHeader("Modifier utilisateur", "Utilisateurs", vm.Alert)
	<div class="card">
		<div class="card-body">
			<form method="post" action={ fmt.Sprintf("/users/%d/edit", user.ID) }>
				<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Prénom</label>
						<input name="first_name" class="form-control" value={ user.FirstName } required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Nom</label>
						<input name="last_name" class="form-control" value={ user.LastName } required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Email</label>
						<input type="email" name="email" class="form-control" value={ user.Email } required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Téléphone</label>
						<input name="phone" class="form-control" value={ user.Phone }/>
					</div>
					<div class="col-12">
						<label class="form-label">Rôles</label>
						<div class="d-flex flex-wrap gap-3">
							for _, r := range models.AllRoles {
								<div class="form-check">
									<input
										class="form-check-input"
										type="checkbox"
										name="roles"
										value={ string(r) }
										id={ fmt.Sprintf("edit-role-%d-%s", user.ID, r) }
										checked?={ user.HasRole(r) }
									/>
									<label class="form-check-label" for={ fmt.Sprintf("edit-role-%d-%s", user.ID, r) }>{ r.Label() }</label>
								</div>
							}
						</div>
					</div>
				</div>
				<div class="mt-3">
					<button class="btn btn-success">Enregistrer</button>
					<a href="/users" class="btn btn-light">Annuler</a>
				</div>
			</form>
		</div>
	</div>
}

templ UserPasswordForm(vm viewmodels.LayoutVM, user *models.User) {
	@AppLayout(vm, userPasswordFormBody(vm, user))
}

templ userPasswordFormBody(vm viewmodels.LayoutVM, user *models.User) {
	@components.PageHeader("Modifier mot de passe", "Utilisateurs", vm.Alert)
	<div class="card">
		<div class="card-body">
			<p class="text-muted mb-3">Utilisateur : <strong>{ user.FullName() }</strong> ({ user.Email })</p>
			<form method="post" action={ fmt.Sprintf("/users/%d/password", user.ID) }>
				<input type="hidden" name="csrf_token" value={ vm.CSRF }/>
				<div class="row g-3">
					<div class="col-md-6">
						<label class="form-label">Nouveau mot de passe</label>
						<input type="password" name="password" class="form-control" minlength="8" required/>
					</div>
					<div class="col-md-6">
						<label class="form-label">Confirmer le mot de passe</label>
						<input type="password" name="password_confirm" class="form-control" minlength="8" required/>
					</div>
				</div>
				<div class="mt-3">
					<button class="btn btn-success">Mettre à jour</button>
					<a href="/users" class="btn btn-light">Annuler</a>
				</div>
			</form>
		</div>
	</div>
}
